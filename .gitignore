# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
build/
dist/

# Virtual env
.venv/
venv/
env/

# uv
.uv-cache/

# IDE / tooling
.vscode/
.idea/
.claude/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local model cache (in case anything bleeds into the repo)
.cache/
models/
*.gguf
*.safetensors

# Derived training artifacts (regenerable from data/recordings/)
data/dataset/

# Training logs
logs/

# Voice training data + checkpoints — STAY OUT OF PUBLIC REPO.
# Publishing these enables impersonation of the speaker. Each user
# generates their own locally; nothing about anyone else's voice ever
# belongs in this repository.
data/recordings/
ckpts/

# Reference clips for the curated system voices (LibriVox-sourced, public
# domain). Derived artifacts — regenerable from the URLs documented in
# data/system_voices/README.md. Keep the WAVs out of git so the repo
# stays small and we don't accidentally republish a specific narrator.
data/system_voices/*.wav

# Local memory store — per-user session history. Never transmitted, never
# committed to git. Lives only on the user's own machine.
data/memory.sqlite
data/memory.sqlite-*

# Same posture for ALL per-user stores (Ask-Your-Files index, built
# instruments, companion log, instrument corpora). Every store creates
# itself on first run; none belongs in git.
data/*.sqlite
data/*.sqlite-*

# Rendered session audio (WAV + MP3) — same privacy posture as memory:
# local-only, never transmitted, never committed. Regenerable from the
# script stored in memory.sqlite if anyone really wanted to.
data/sessions/

# Internal strategy / competitive research — NEVER push. These are our
# private war-map (landscape, distribution GTM, competitive watch). Local
# only so they can't leak when we push product branches/PRs. The PUBLIC
# narrative spine (strategy.md, decisions-log.md, daily-log.md, README)
# stays tracked; the internal analysis does not.
docs/internal/

# Test corpora — fetchable public-domain artifacts, not committed (see testing-plan.md)
data/test_corpus/

# Training corpus — fair-use inputs, NEVER redistributed (no copies in repo)
data/corpus/
data/voice_training/
data/model/
dist/
